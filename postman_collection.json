    {
      "name": "Analytics",
      "item": [
        {
          "name": "Get Dashboard Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/admin/analytics/dashboard",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "admin",
                "analytics",
                "dashboard"
              ]
            },
            "description": "Computes platform-wide counter stats (Total Users, Active Users, Total Surveys/Games active, Pending Redemptions)."
          }
        },
        {
          "name": "Get Financial Analytics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/admin/analytics/financial?timeWindow=monthly",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "admin",
                "analytics",
                "financial"
              ],
              "query": [
                {
                  "key": "timeWindow",
                  "value": "monthly",
                  "description": "Time window: daily, weekly, monthly"
                }
              ]
            },
            "description": "Aggregates total points issued vs points redeemed, net platform profit margins."
          }
        },
        {
          "name": "Get User Growth Data",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/admin/analytics/user-growth",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "admin",
                "analytics",
                "user-growth"
              ]
            },
            "description": "Returns time-series data of new user registrations for user acquisition curves."
          }
        }
